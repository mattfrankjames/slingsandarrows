# Node.js
node_modules/
npm-debug.log
yarn-error.log

# Logs
logs/
*.log
*.log.*

# Dependency directories
jspm_packages/
bower_components/

# Environment variables
.env

# IDEs and editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS files
.DS_Store
Thumbs.db

# Build directories
dist/
build/
out/

# Coverage directory used by tools like istanbul
coverage/

# Temporary files
*.tmp
*.swp
*.bak
*.pid
*.seed
*.pid.lock

# Compiled source
*.com
*.class
*.dll
*.exe
*.o
*.so

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Compiled JavaScript (exceptions below allow source JS files)
*.jsx
*.ts
*.tsx
*.map

# Allow netlify functions and src JS modules
!netlify/functions/*.js
!src/js/*.js
!src/sw.js

# Hand-written type declarations are source, not build output. Without this
# they match the `*.ts` rule above and silently never get committed — which
# passes locally and fails in CI, where the file does not exist.
!types/*.d.ts

# Static site builds
public/

**/.DS_Store

.parcel-cache/

# Test output
test-results/
playwright-report/
blob-report/
.lighthouseci/

# Eleventy's intermediate output; Parcel builds dist/ from it
.eleventy/

# Visual baselines captured on a laptop. Only the runners' linux/ set is
# committed and only that set gates a merge; snapshotPathTemplate keys on
# {platform}, so a local run writes its own directory rather than overwriting
# CI's. Those files are captured against whatever preview was handy and are
# throwaway — ignored so a green local run cannot be mistaken for CI agreeing.
tests/browser/__screenshots__/darwin/

# Local Netlify folder. `netlify dev` writes bundled functions here, and
# `netlify db` keeps the local WASM Postgres under it.
.netlify

# Written by `netlify dev` when it prepares the edge-functions runtime. It
# pins Deno's dependencies, not ours — nothing in this repo imports from Deno,
# and it reappears on any machine that runs the dev server.
deno.lock
