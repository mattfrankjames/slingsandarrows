{#
  Everything inside <head> that was previously copied into all eight pages.

  Open Graph and Twitter tags were on six of the eight — community and post
  shipped without them, so a link to either previewed as a bare URL. There is
  one head now, so that is no longer a per-page decision.
#}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="{{ site.themeColor }}">

{# iOS / Safari PWA #}
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="{{ site.shortName }}">

<title>{{ title }}</title>
<meta name="description" content="{{ description }}">

{% set pageUrl = site.url + (page.url | default('/') | cleanUrl) %}
<link rel="canonical" href="{{ pageUrl }}">

{% set ogImage = 'https://res.cloudinary.com/' + site.media.cloudinaryCloud + '/image/upload/f_auto,q_80,w_1200/' + site.media.heroPublicId %}

{# Open Graph #}
<meta property="og:type" content="website">
<meta property="og:url" content="{{ pageUrl }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ site.name }} hero image">
<meta property="og:site_name" content="{{ site.name }}">

{# Twitter Card #}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:url" content="{{ pageUrl }}">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImage }}">

<link rel="dns-prefetch" href="https://res.cloudinary.com">

{% include "partials/fonts.njk" %}

{# The hero photograph is the .wrapper background on every page, so it is the
   largest contentful paint nearly everywhere. #}
<link rel="preload"
  href="https://res.cloudinary.com/{{ site.media.cloudinaryCloud }}/image/upload/f_auto,q_80,w_1920/{{ site.media.heroPublicId }}"
  as="image"
  fetchpriority="high"
  imagesrcset="https://res.cloudinary.com/{{ site.media.cloudinaryCloud }}/image/upload/f_auto,q_80,w_768/{{ site.media.heroPublicId }} 768w,
               https://res.cloudinary.com/{{ site.media.cloudinaryCloud }}/image/upload/f_auto,q_80,w_1920/{{ site.media.heroPublicId }} 1920w"
  imagesizes="100vw">

<link href="./core/styles/index.css" rel="stylesheet">

{# SVG for the address bar; PNG for iOS, which ignores SVG here. #}
<link rel="icon" type="image/svg+xml" href="./site/favicon.svg">
<link rel="apple-touch-icon" href="./site/images/icon-192.png">
<link rel="manifest" href="./site/manifest.json">
