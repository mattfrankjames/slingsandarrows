---
title: "Slings & Arrows | Upcoming Shows"
description: "Upcoming and past concert dates for Slings & Arrows. Check out our live shows."
permalink: "/shows.html"
---
{% extends "layouts/base.njk" %}

{% block content %}
			<div class="shows" id="shows">
				<h2 class="text-2xl font-bold mb-4">Upcoming Shows</h2>
				<div id="upcoming-shows"></div>

				<h2 class="text-2xl font-bold mt-8 mb-4">Past Shows</h2>
				<div id="past-shows"></div>
			</div>
{% endblock %}

{% block afterBody %}
<script type="module">
			import showsData from './site/data/shows.json';
			import { loadIdentityWidgetIfTokenPresent } from './core/js/identity-widget.js';

			if (document.readyState === 'complete') {
				loadIdentityWidgetIfTokenPresent();
			} else {
				window.addEventListener('load', loadIdentityWidgetIfTokenPresent, { once: true });
			}

			function buildList(shows) {
		const upcomingShows = shows.filter(show => show.status === "upcoming");
		const pastShows = shows.filter(show => show.status === "past").reverse();

			// Hide the container as well as the heading. #upcoming-shows carries a
			// static-texture divider in its ::after, which with nothing above it
			// renders as a stray bar between a hidden heading and "Past shows".
			// Nothing had ever emptied this list before, so the empty state had
			// never actually been looked at.
			const upcomingHeading = document.querySelector('#shows h2:first-of-type');
			const upcomingContainer = document.getElementById('upcoming-shows');
			const noneUpcoming = upcomingShows.length === 0;
			upcomingHeading.hidden = noneUpcoming;
			upcomingContainer.hidden = noneUpcoming;

			function createShowList(shows, containerId) {
			const container = document.getElementById(containerId);
			const isUpcoming = containerId === "upcoming-shows";

			shows.forEach((show) => {
				const showDiv = document.createElement("div");
				showDiv.classList.add("show", "mb-4", "p-4", "border", "border-white", "rounded");

					const heading = isUpcoming && show.venueHref
						? `<h3 class="text-xl font-bold mb-2"><a href="${show.venueHref}" target="_blank" rel="noopener noreferrer">${show.date}: ${show.venue}</a></h3>`
						: `<h3 class="text-xl font-bold mb-2">${show.date}: ${show.venue}</h3>`;
					// Each part is optional and printed only if it is there. A show can
					// have a start time and no separate door time, or be free with no
					// ticket price; the single template this replaces keyed the whole
					// line off doorTime and printed "undefined" for the rest.
					const detailParts = [
						show.doorTime ? `<span>Doors:</span> ${show.doorTime}` : '',
						show.showTime ? `<span>Music:</span> ${show.showTime}` : '',
						show.cost || '',
					].filter(Boolean);
					const showDetails = detailParts.length
						? `<div class="subtext">${detailParts.join(' | ')}</div>`
						: '';

					// Whatever else is worth knowing about the event — who is putting it
					// on, what is there besides the bands. Inside the details block, so a
					// note strikes it along with everything else that did not happen.
					const info = show.info ? `<div class="subtext">${show.info}</div>` : '';

					// A note means the show did not happen as listed. Its details are
					// struck through, but the note itself is not — the strike is
					// decoration, and decoration is not announced, so the reason has to
					// be readable text rather than a visual effect on the old details.
					const note = show.note
						? `<p class="show-note">${show.note}</p>`
						: '';
					const details = `
									${heading}
									<h4 class="mb-0">With:</h4>
									<ul class="lineup mb-1">
											${show.lineup.map(artist => `<li>${artist}</li>`).join('')}
									</ul>
									${showDetails}
									${info}
							`;
					showDiv.innerHTML = show.note
						? `<div class="show-struck">${details}</div>${note}`
						: details;
					container.appendChild(showDiv);
				});
		}

		createShowList(upcomingShows, "upcoming-shows");
		createShowList(pastShows, "past-shows");
	}

	buildList(showsData);
</script>
{% endblock %}
