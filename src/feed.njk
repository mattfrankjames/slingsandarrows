---
title: "Slings & Arrows | Feed"
description: "Latest updates and announcements from Slings & Arrows"
permalink: "/feed.html"
pageStyles: feed
identityWidget: true
---
{% extends "layouts/base.njk" %}

{% block content %}
      <div class="posts-container">
        <div id="auth-bar" hidden class="auth-bar">
          <span id="auth-bar-email" class="auth-bar-email"></span>
          <button class="btn btn-sm" id="auth-bar-logout">Sign Out</button>
        </div>
        <div class="page-heading">
          <h2>Posts</h2>
          <button type="button" id="new-post-btn" class="btn btn-sm new-post-btn" hidden
            aria-haspopup="dialog" aria-controls="post-composer-dialog">+ New Post</button>
          <a id="rss-btn" href="#" class="rss-btn"
            aria-label="Copy the Posts RSS feed URL to subscribe in your reader"
            title="Copy RSS feed URL">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20"
              viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20
                C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0
                0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1
                9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
            <span class="rss-tooltip" role="status" aria-live="polite"></span>
          </a>
        </div>
        <div id="loading" role="status" aria-live="polite" hidden>Loading…</div>
        <div id="empty-state" hidden>No posts yet.</div>
        <div id="error-state" hidden>Could not load posts.</div>
        <div id="posts-feed"></div>
      </div>
{% endblock %}

{% block afterBody %}
<script type="module" src="./core/js/posts.js"></script>
  <script>
    // RSS feed URL set at runtime so Parcel doesn't try to resolve /feed.xml as a local asset.
    // The button copies the absolute feed URL to the clipboard (browsers have no native
    // "open in reader" action) so the user can paste it into their feed reader.
    (function () {
      var FEED_URL = window.location.origin + '/feed.xml';
      var link = document.getElementById('rss-link');
      var btn = document.getElementById('rss-btn');
      if (link) link.href = FEED_URL;
      if (!btn) return;
      btn.href = FEED_URL;

      var tip = btn.querySelector('.rss-tooltip');
      var hideTimer;
      function flash(msg) {
        if (!tip) return;
        tip.textContent = msg;
        tip.classList.add('show');
        clearTimeout(hideTimer);
        hideTimer = setTimeout(function () { tip.classList.remove('show'); }, 2000);
      }

      function copy(text) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          return navigator.clipboard.writeText(text);
        }
        return new Promise(function (resolve, reject) {
          try {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            var ok = document.execCommand('copy');
            document.body.removeChild(ta);
            ok ? resolve() : reject();
          } catch (err) { reject(err); }
        });
      }

      btn.addEventListener('click', function (e) {
        // Let modified / non-primary clicks behave like a normal link (open, copy link, new tab)
        if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        copy(FEED_URL).then(function () {
          flash('Feed URL copied — paste into your reader');
        }).catch(function () {
          // Clipboard unavailable: fall back to navigating so the URL is in the address bar
          window.location.href = FEED_URL;
        });
      });
    })();
  </script>
{% endblock %}
